  "item": [
    {
      "name": "Auth - register editor",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('register returns 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('register response has token and user', () => {",
              "  pm.expect(body).to.have.property('accessToken');",
              "  pm.expect(body.user).to.have.property('email');",
              "  pm.expect(body.user).to.have.property('role');",
              "});",
              "pm.environment.set('token', body.accessToken);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"editor{{$timestamp}}@ecorepair.test\",\n  \"password\": \"password123\",\n  \"role\": \"EDITOR\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        }
      },
      "response": []
    },
